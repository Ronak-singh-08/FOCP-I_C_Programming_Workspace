
#include <stdio.h>

int maxOfThree(int a, int b, int c)
{
    if (a >= b && a >= c)
        return a;
    else if (b >= a && b >= c)
        return b;
    else
        return c;
}

int main()
{
    int a, b, c;

    scanf("%d %d %d", &a, &b, &c);

    printf("%d", maxOfThree(a, b, c));

    return 0;
}





#include <stdio.h>

int countMultiples(int n, int k)
{
    return n / k;
}

int main()
{
    int n, k;

    scanf("%d %d", &n, &k);

    if (n < 1 || k < 1)
        return 0;

    printf("%d", countMultiples(n, k));

    return 0;
}





