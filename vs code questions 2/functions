#include <stdio.h>

int isPerfectSquare(int n)
{
    if (n < 0)
        return 0;

    int i = 0;

    while (i <= n / (i + 1))
    {
        if (i * i == n)
            return 1;

        i++;
    }

    return 0;
}

int main()
{
    int n;

    scanf("%d", &n);

    printf("%d", isPerfectSquare(n));

    return 0;
}






#include <stdio.h>

int gcd(int a, int b)
{
    if (a < 0)
        a = -a;

    if (b < 0)
        b = -b;

    while (b != 0)
    {
        int temp = b;
        b = a % b;
        a = temp;
    }

    return a;
}

int main()
{
    int a, b;

    scanf("%d %d", &a, &b);

    printf("%d", gcd(a, b));

    return 0;
}






#include <stdio.h>

int main()
{
    int totalSeconds;
    int hours, minutes, seconds;

    scanf("%d", &totalSeconds);

    hours = totalSeconds / 3600;
    minutes = (totalSeconds % 3600) / 60;
    seconds = totalSeconds % 60;

    printf("%d %d %d", hours, minutes, seconds);

    return 0;
}







