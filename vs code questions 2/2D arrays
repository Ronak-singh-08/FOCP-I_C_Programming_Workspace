
#include <stdio.h>

int main()
{
    int r, c;
    int a[100][100];

    scanf("%d %d", &r, &c);

    for (int i = 0; i < r; i++)
    {
        for (int j = 0; j < c; j++)
        {
            scanf("%d", &a[i][j]);
        }
    }

    // Calculate row sums
    for (int i = 0; i < r; i++)
    {
        int sum = 0;

        for (int j = 0; j < c; j++)
        {
            sum += a[i][j];
        }

        printf("%d ", sum);
    }

    printf("\n");

    // Calculate column sums
    for (int j = 0; j < c; j++)
    {
        int sum = 0;

        for (int i = 0; i < r; i++)
        {
            sum += a[i][j];
        }

        printf("%d ", sum);
    }

    return 0;
}







#include <stdio.h>

int main()
{
    int n, a[100][100];
    int symmetric = 1;

    scanf("%d", &n);

    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < n; j++)
        {
            scanf("%d", &a[i][j]);
        }
    }

    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < n; j++)
        {
            if (a[i][j] != a[j][i])
            {
                symmetric = 0;
                break;
            }
        }
    }

    if (symmetric == 1)
        printf("YES");
    else
        printf("NO");

    return 0;
}
