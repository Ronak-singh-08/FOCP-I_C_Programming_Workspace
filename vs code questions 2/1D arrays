
#include <stdio.h>

int main()
{
    int n, a[1000];
    int count = 1, maxLength = 1;

    scanf("%d", &n);

    for (int i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
    }

    for (int i = 1; i < n; i++)
    {
        if (a[i] > a[i - 1])
        {
            count++;
        }
        else
        {
            count = 1;
        }

        if (count > maxLength)
        {
            maxLength = count;
        }
    }

    printf("%d", maxLength);

    return 0;
}






